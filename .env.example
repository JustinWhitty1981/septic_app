# Copy to .env and edit. NEVER commit .env.
#   cp .env.example .env
#
# Generate a real JWT secret with:
#   openssl rand -base64 48

# --- Postgres (dev container) ---
DATABASE_USER=septic_dev
DATABASE_PASSWORD=change-me-dev-only
DATABASE_NAME=septic

# --- Auth ---
# REQUIRED. docker compose refuses to start if this is unset or left blank.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Object storage for job photos (MinIO in dev, S3 in prod) ---
S3_BUCKET=septic-media-dev
S3_ACCESS_KEY_ID=septic_dev
S3_SECRET_ACCESS_KEY=change-me-dev-only-min-8-chars
