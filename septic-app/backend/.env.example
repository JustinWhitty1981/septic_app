# Copy to .env and fill in. Names here must match what src/ and docker-compose.yml
# actually read — `npm test` asserts that every key in .env appears here.
#
# Nothing in this file is a real credential. Never put a real secret in it.

# --- Database -------------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=septic
DATABASE_USER=septic_dev
DATABASE_PASSWORD=change-me-dev-only

# --- Authentication -------------------------------------------------------
# Required: compose refuses to start without it. Generate with:
#   openssl rand -base64 48
# The application has a development fallback, so a missing value here fails
# quietly rather than loudly — that is why compose makes it mandatory.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Server ---------------------------------------------------------------
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Object storage (MinIO locally, S3 in production) ---------------------
# The client is configured through S3_*, not AWS_*: the legacy AWS_* names in
# earlier revisions of this file were never read by the current code.
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=septic-media-dev
S3_ACCESS_KEY_ID=septic_dev
S3_SECRET_ACCESS_KEY=change-me-dev-only-min-8-chars
# Required for MinIO; leave true unless talking to real AWS.
S3_FORCE_PATH_STYLE=true
