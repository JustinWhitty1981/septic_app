FROM node:22-alpine

WORKDIR /app

# Install PostgreSQL client for migrations
RUN apk add --no-cache postgresql-client

# Copy package files
COPY package*.json ./

# Install dependencies (including devDependencies for TypeScript compilation)
RUN npm install && npm cache clean --force

# Copy source code (includes tsconfig.json and .ts files)
COPY . .

# Compile TypeScript to JavaScript
RUN npm run build

# Copy migration scripts (separate layer for caching)
COPY ./scripts/migrations /app/scripts/migrations

# Create migration script
RUN echo '#!/bin/sh\n\
set -e\n\
\n\
echo "Running database migrations..."\n\
psql -h $DB_HOST -p $DB_PORT -U $DB_USER -d $DB_DATABASE -f /app/scripts/migrations/001-create-schema.sql\n\
echo "Migrations complete"\n\
' > /app/scripts/migrate.sh && chmod +x /app/scripts/migrate.sh

# Expose port
EXPOSE 3001

# Production command
CMD ["npm", "run", "start"]
